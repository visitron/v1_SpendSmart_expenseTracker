<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>All Transactions | SpendSmart</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">

  <style>
    * { font-family: 'Poppins', sans-serif; }

    :root {
      --primary: #6b7280;
      --accent: #4b5563;
      --dark: #1f2937;
      --light: #f3f4f6;
      --border: #d1d5db;
      --success: #10b981;
      --danger: #ef4444;
    }

    body {
      background: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%);
      min-height: 100vh;
      color: var(--dark);
    }

    .page-header {
      background: linear-gradient(135deg, #4b5563 0%, #3d4556 100%);
      color: white;
      padding: 3rem 2rem;
      margin-bottom: 2rem;
      box-shadow: 0 8px 25px rgba(0,0,0,0.1);
    }

    .page-header h1 {
      font-size: 2.2rem;
      font-weight: 800;
      margin: 0 0 0.5rem 0;
    }

    .page-header p {
      margin: 0;
      opacity: 0.9;
      font-size: 1.05rem;
    }

    .container-main {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1rem;
    }

    .transactions-card {
      background: white;
      border-radius: 15px;
      padding: 2rem;
      box-shadow: 0 6px 20px rgba(0,0,0,0.08);
      border: 1px solid var(--border);
    }

    .transactions-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
      padding-bottom: 1rem;
      border-bottom: 2px solid var(--light);
    }

    .transactions-header h5 {
      font-size: 1.3rem;
      font-weight: 700;
      color: var(--dark);
      margin: 0;
    }

    .transactions-header .count {
      color: var(--primary);
      font-size: 0.9rem;
      font-weight: 600;
    }

    .controls-bar {
      display: flex;
      gap: 1rem;
      margin-bottom: 1.5rem;
      align-items: center;
      flex-wrap: wrap;
    }

    .search-box {
      flex: 1;
      min-width: 250px;
    }

    .search-box input {
      border-radius: 10px;
      border: 2px solid var(--border);
      padding: 0.7rem 1rem;
      font-weight: 500;
      transition: all 0.3s;
    }

    .search-box input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 0.2rem rgba(75, 85, 99, 0.15);
      outline: none;
    }

    .btn-back {
      background: var(--light);
      color: var(--accent);
      border: 2px solid var(--accent);
      padding: 0.7rem 1.2rem;
      border-radius: 10px;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.3s;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    .btn-back:hover {
      background: var(--accent);
      color: white;
    }

    .table {
      margin: 0;
      font-size: 0.95rem;
    }

    .table thead th {
      background: var(--light);
      color: var(--dark);
      font-weight: 700;
      border: none;
      padding: 1rem;
      text-transform: uppercase;
      font-size: 0.85rem;
      letter-spacing: 0.5px;
    }

    .table tbody td {
      padding: 1.2rem;
      vertical-align: middle;
      border-color: var(--light);
    }

    .table tbody tr:hover {
      background: var(--light);
      transition: background 0.2s;
    }

    .badge {
      padding: 0.5rem 1rem;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.85rem;
    }

    .badge-income {
      background: #d1fae5;
      color: #065f46;
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
    }

    .badge-expense {
      background: #fee2e2;
      color: #7f1d1d;
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
    }

    .badge-category {
      background: var(--light);
      color: var(--dark);
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
    }

    .transaction-amount {
      font-weight: 700;
      color: var(--dark);
      font-size: 1rem;
    }

    .transaction-note {
      font-size: 0.85rem;
      color: var(--primary);
      margin-top: 0.3rem;
    }

    .action-buttons {
      display: flex;
      gap: 0.5rem;
    }

    .btn-sm {
      padding: 0.5rem 0.75rem;
      font-size: 0.85rem;
      border-radius: 8px;
      font-weight: 600;
      border-width: 2px;
    }

    .btn-outline-primary {
      color: var(--accent);
      border-color: var(--accent);
    }

    .btn-outline-primary:hover {
      background: var(--accent);
      border-color: var(--accent);
      color: white;
    }

    .btn-outline-danger {
      color: var(--danger);
      border-color: var(--danger);
    }

    .btn-outline-danger:hover {
      background: var(--danger);
      border-color: var(--danger);
      color: white;
    }

    .page-footer {
      text-align: center;
      padding: 2rem;
      color: var(--primary);
      font-weight: 500;
    }

    .empty-state {
      text-align: center;
      padding: 3rem;
      color: var(--primary);
    }

    .empty-state i {
      font-size: 3rem;
      color: var(--light);
      margin-bottom: 1rem;
    }

    @media (max-width: 768px) {
      .controls-bar {
        flex-direction: column;
        align-items: stretch;
      }

      .search-box {
        min-width: auto;
      }

      .page-header {
        padding: 2rem 1rem;
      }

      .page-header h1 {
        font-size: 1.8rem;
      }

      .table {
        font-size: 0.85rem;
      }

      .table thead th,
      .table tbody td {
        padding: 0.75rem 0.5rem;
      }
    }
  </style>
</head>
<body>
  <!-- Page Header -->
  <div class="page-header">
    <div class="container-main">
      <h1><i class="fas fa-list-check me-2"></i>All Transactions</h1>
      <p>View and manage all your transactions</p>
    </div>
  </div>

  <!-- Main Content -->
  <div class="container-main">
    <div class="transactions-card">
      <!-- Header & Controls -->
      <div class="transactions-header">
        <h5><i class="fas fa-history me-2"></i>Transactions List</h5>
        <span class="count">Showing <strong id="txCount"><%= transactions.length %></strong> items</span>
      </div>

      <!-- Search & Back Button -->
      <div class="controls-bar">
        <div class="search-box">
          <input type="text" id="tableSearch" class="form-control" placeholder="Search by description or category...">
        </div>
        <a href="/" class="btn-back">
          <i class="fas fa-arrow-left"></i> Dashboard
        </a>
      </div>

      <!-- Table -->
      <div class="table-responsive">
        <table id="txTable" class="table table-hover">
          <thead>
            <tr>
              <th style="min-width: 120px;">Amount</th>
              <th style="min-width: 100px;">Type</th>
              <th>Description</th>
              <th style="min-width: 140px;">Category</th>
              <th style="min-width: 160px;">Date</th>
              <th style="min-width: 150px;">Actions</th>
            </tr>
          </thead>
          <tbody id="txBody">
            <% if (transactions.length === 0) { %>
              <tr>
                <td colspan="6" class="empty-state">
                  <i class="fas fa-inbox"></i>
                  <p>No transactions found</p>
                </td>
              </tr>
            <% } else { %>
              <% transactions.forEach(tx => { %>
                <tr data-desc="<%= (tx.description || '').toLowerCase() %>" data-cat="<%= (tx.category_name || '').toLowerCase() %>">
                  <td>
                    <div class="transaction-amount">₹ <span class="raw-amt"><%= tx.amount %></span></div>
                    <% if(tx.note) { %><div class="transaction-note"><%= tx.note %></div><% } %>
                  </td>
                  <td>
                    <% if(tx.transaction_type && tx.transaction_type.toLowerCase() === 'income') { %>
                      <span class="badge badge-income"><i class="fas fa-arrow-down"></i> Income</span>
                    <% } else { %>
                      <span class="badge badge-expense"><i class="fas fa-arrow-up"></i> Expense</span>
                    <% } %>
                  </td>
                  <td><%= tx.description %></td>
                  <td>
                    <% if(tx.category_name) { %>
                      <span class="badge badge-category"><i class="fas fa-tag"></i> <%= tx.category_name %></span>
                    <% } else { %>
                      <span style="color: var(--primary);">N/A</span>
                    <% } %>
                  </td>
                  <td><%= new Date(tx.transaction_time).toLocaleString() %></td>
                  <td>
                    <div class="action-buttons">
                      <a href="/edit/<%= tx.id %>" class="btn btn-sm btn-outline-primary">Edit</a>
                      <form action="/delete/<%= tx.id %>" method="POST" class="d-inline delete-form">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="page-footer">
      Made with ❤️ by <strong>SpendSmart</strong>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    // Format currency
    (function formatAmounts() {
      const formatter = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 2 });
      document.querySelectorAll('.raw-amt').forEach(el => {
        const n = Number(el.textContent || '0');
        if (!isNaN(n)) el.textContent = formatter.format(n).replace('₹', '').trim();
      });
    })();

    // Search/Filter
    document.getElementById('tableSearch').addEventListener('input', function() {
      const q = this.value.trim().toLowerCase();
      const rows = document.querySelectorAll('#txBody tr');
      let visible = 0;
      rows.forEach(r => {
        const desc = r.getAttribute('data-desc') || '';
        const cat = r.getAttribute('data-cat') || '';
        const matches = !q || desc.includes(q) || cat.includes(q);
        r.style.display = matches ? '' : 'none';
        if (matches) visible++;
      });
      document.getElementById('txCount').textContent = visible;
    });

    // Delete confirmation
    document.querySelectorAll('.delete-form').forEach(f => {
      f.addEventListener('submit', function(ev) {
        if (!confirm('Delete this transaction? This action cannot be undone.')) ev.preventDefault();
      });
    });
  </script>
</body>
</html>
